    {
      "name": "535343a9",
      "displayName": "Top Cities Ranked by Patient Volume Summary",
      "queryLines": [
        "select city, count(*) as patient_count\n",
        "from dim_patient\n",
        "group by city\n",
        "order by patient_count desc\n",
        "limit 10"
      ],
      "catalog": "workspace",
      "schema": "gold"
    },
    {
      "name": "top_patients_visits",
      "displayName": "Top Patients by Visit Count",
      "queryLines": [
        "SELECT\n",
        "  e.patient_key,\n",
        "  p.gender,\n",
        "  p.age,\n",
        "  p.city,\n",
        "  COUNT(*) as visit_count\n",
        "FROM\n",
        "  workspace.gold.fact_encounter e\n",
        "    INNER JOIN workspace.gold.dim_patient p\n",
        "      ON e.patient_key = p.patient_key\n",
        "GROUP BY\n",
        "  e.patient_key,\n",
        "  p.gender,\n",
        "  p.age,\n",
        "  p.city\n",
        "ORDER BY\n",
        "  visit_count DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "encounters_by_year",
      "displayName": "Encounters by Year",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  e.encounter_key,\n  e.patient_key,\n  e.encounter_type,\n  d.year,\n  d.month_name,\n  d.quarter\nFROM workspace.gold.fact_encounter e INNER JOIN workspace.gold.dim_date d ON e.date_key = d.date_key WHERE d.year >= 2010\n",
        "dimensions": [
          {
            "name": "year",
            "expr": "year",
            "displayName": "Year"
          },
          {
            "name": "month_name",
            "expr": "month_name",
            "displayName": "Month"
          },
          {
            "name": "quarter",
            "expr": "quarter",
            "displayName": "Quarter"
          },
          {
            "name": "encounter_type",
            "expr": "encounter_type",
            "displayName": "Encounter Type"
          }
        ],
        "measures": [
          {
            "name": "encounter_count",
            "expr": "COUNT(*)",
            "displayName": "Total Encounters",
            "comment": "Count of all encounters"
          }
        ]
      }
    },
    {
      "name": "monthly_encounters",
      "displayName": "Monthly Encounter Trends",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  e.encounter_key,\n  d.month_name,\n  d.year\nFROM workspace.gold.fact_encounter e INNER JOIN workspace.gold.dim_date d ON e.date_key = d.date_key WHERE d.year >= 2010\n",
        "dimensions": [
          {
            "name": "month_name",
            "expr": "month_name",
            "displayName": "Month"
          },
          {
            "name": "year",
            "expr": "year",
            "displayName": "Year"
          }
        ],
        "measures": [
          {
            "name": "encounter_count",
            "expr": "COUNT(*)",
            "displayName": "Total Encounters",
            "comment": "Count of encounters by month"
          }
        ]
      }
    },
    {
      "name": "top_conditions",
